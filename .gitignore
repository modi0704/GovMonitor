# Customer reference workbooks (read-only, never committed)
reference/

# Secrets / local env
.env
.env.*
!.env.example
!deploy/*.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/

# Runtime data
var/
backend/staticfiles/
backend/media/
*.log

# Editors / OS
.idea/
.vscode/
.DS_Store

# Deployment secrets (keep the folders)
deploy/certs/*
!deploy/certs/.gitkeep
deploy/licence/*
!deploy/licence/.gitkeep
deploy/cloud.env

# Local backups made by deploy/backup.sh
backups/

# Offline bundles (deploy/make-offline-bundle.sh)
/dist/
