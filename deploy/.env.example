# Single-machine install (deploy/docker-compose.yml). Copy to deploy/.env and change every value
# marked CHANGE before real use. Generate secrets with:  openssl rand -base64 48
DEPLOYMENT_MODE=single
SECRET_KEY=CHANGE-to-a-long-random-string
# Sign-in: 0 = everyone signs in (servers that other computers reach). 1 = no sign-in, for one
# PC only (the default when there is no .env; ./run.sh login on|off changes it).
LOGIN_DISABLED=0
POSTGRES_PASSWORD=CHANGE-me
APP_OWNER_PASSWORD=CHANGE-me
APP_USER_PASSWORD=CHANGE-me

# How people reach the server: its DNS name or IP address.
#   SITE_ADDRESS=monitor.example.gov   + TLS_MODE empty  → automatic public certificate (needs internet)
#   SITE_ADDRESS=https://192.168.1.10  + TLS_MODE=internal → the server's own certificate authority
#   TLS_MODE=/certs/cert.pem /certs/key.pem              → your own certificate, files in deploy/certs/
#   SITE_ADDRESS=http://:80 and SECURE_SSL=0             → plain HTTP (only behind a VPN or another proxy)
SITE_ADDRESS=localhost
TLS_MODE=internal
SECURE_SSL=1
# Every name or address in SITE_ADDRESS, plus localhost for health checks.
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=https://localhost
# Used in links inside alert emails.
PUBLIC_URL=https://localhost

# Email (optional): smtp://user:password@smtp.example.gov:587 ; empty = alerts in the app only.
EMAIL_URL=
MAX_UPLOAD_MB=25
MAX_BODY_MB=30
SESSION_IDLE_MINUTES=60
# Office installs: the licence file from the vendor, saved as licence/licence.json next to this file.
# Without a valid licence a single-agency install is read-only (reading and exports still work).
LICENCE_FILE=/licence/licence.json
HTTP_PORT=80
HTTPS_PORT=443
WEB_PORT=8000
