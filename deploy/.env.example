# Copy to deploy/.env and change every password and the secret key before real use.
DEPLOYMENT_MODE=multi
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
APP_OWNER_PASSWORD=change-me
APP_USER_PASSWORD=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
EMAIL_URL=
# Public address of the site, used for links in alert emails (e.g. https://monitor.example.gov)
PUBLIC_URL=
WEB_PORT=8000
