# Cloud service (deploy/docker-compose.cloud.yml). Copy to deploy/cloud.env and fill in.
DEPLOYMENT_MODE=multi
SECRET_KEY=CHANGE-to-a-long-random-string
ALLOWED_HOSTS=monitor.example.gov
CSRF_TRUSTED_ORIGINS=https://monitor.example.gov
PUBLIC_URL=https://monitor.example.gov

# Managed PostgreSQL 16+: two roles (see deploy/db/init-roles.sh). TLS: add ?sslmode=require.
DATABASE_URL=postgres://app_user:CHANGE@db.example.internal:5432/govmonitor?sslmode=require
DATABASE_ADMIN_URL=postgres://app_owner:CHANGE@db.example.internal:5432/govmonitor?sslmode=require

# S3-compatible storage for supporting files and exports (private bucket).
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=govmonitor-files
S3_ACCESS_KEY=CHANGE
S3_SECRET_KEY=CHANGE

EMAIL_URL=
MAX_UPLOAD_MB=25
SESSION_IDLE_MINUTES=60
WEB_PORT=8000
WEB_CONCURRENCY=4
# Image to run (from your registry or loaded with docker load).
GOVMONITOR_IMAGE=govmonitor
GOVMONITOR_VERSION=dev
